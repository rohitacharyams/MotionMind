# Copy to .env and fill in. NEVER commit the real .env.

# --- Speech (Azure Cognitive Services, F0 free tier works) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# --- LLM brain (Groq free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional: vision-language model via HuggingFace Inference (free tier) ---
HF_TOKEN=
QWEN_VL_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# --- Optional: Gemini Live (speech-to-speech). Get a key at ---
# https://aistudio.google.com/apikey  . Leave empty to fall back to
# the Azure STT -> Groq -> Azure TTS voice pipeline.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-preview
GEMINI_LIVE_VOICE=Aoede

# --- Optional: external identity backend (delegated JWT verification). ---
# Leave empty to run fully anonymous / standalone.
STUDIOOS_API=

# --- Optional: Web Push (browser notifications). Generate a keypair with ---
# python -m coach.notifications  (prints VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com
