# Pipeline-side settings (copy to .env). Coach/runtime keys live in coach/.env.

# Device for pose extraction / SMPL fitting: auto | cpu | cuda
DEVICE=auto

# Optional HuggingFace token for gated models (e.g. some pose/SMPL checkpoints).
HF_TOKEN=

# Where the pipeline reads/writes assets (defaults are fine).
DATA_DIR=data
MOTION_CACHE_DIR=coach/motion_cache
